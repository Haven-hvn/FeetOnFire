{
  "name": "feet-on-fire",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "StepMania-compatible browser game (TypeScript).",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "watch": "vite build --watch",
    "watch:types": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "serve": "node scripts/dev-server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "@filoz/synapse-core": "0.11.1",
    "@filoz/synapse-sdk": "3.0.1",
    "@icp-sdk/core": "6.1.2",
    "@icp-sdk/vetkeys": "0.7.0",
    "@reown/appkit": "2.0.0",
    "@reown/appkit-adapter-wagmi": "2.0.0",
    "@wagmi/connectors": "8.2.4",
    "@wagmi/core": "3.6.9",
    "viem": "2.58.6",
    "wagmi": "3.7.11"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
